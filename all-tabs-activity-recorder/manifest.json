{
  "manifest_version": 3,
  "name": "All Tabs Activity Recorder",
  "version": "0.2.0",
  "description": "Records user interactions across Chrome tabs during an explicitly started session.",
  "permissions": ["tabs", "scripting", "storage", "webNavigation", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Activity Recorder" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
