{
  "manifest_version": 3,
  "name": "Naver Price Dumper (local)",
  "version": "0.4.8",
  "minimum_chrome_version": "106",
  "description": "로컬 릴레이(127.0.0.1:8787)의 작업 목록 URL을 열어 화면 텍스트와 링크를 덤프해 되돌려 보낸다. 해석은 로컬 스크립트가 한다.",
  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "https://*/*",
    "http://*/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "recorder.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Naver Price Dumper",
    "default_popup": "popup.html"
  }
}
